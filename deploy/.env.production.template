# =============================================================================
# moovli-web — production environment template
# =============================================================================
# Copy to /opt/apps/moovli-web/.env.production on the droplet BEFORE running
# `npm run build`. Next.js bakes NEXT_PUBLIC_* values into the client bundle
# at build time — changes here require a rebuild + PM2 reload to take effect.
#
#   cp deploy/.env.production.template /opt/apps/moovli-web/.env.production
#   # fill in the secrets below, then:
#   npm ci && npm run build
#   pm2 reload moovli-web
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Server-side (NOT exposed to the browser)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Port Next.js listens on inside the droplet — must match the upstream in
# both nginx configs and the PM2 ecosystem.
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# Public — these get bundled into the browser. NEVER put server secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# moovli-api base URL the dashboard hits for all REST calls.
NEXT_PUBLIC_API_URL=https://api.moovli.app

# Supabase cloud project. Anon key is publishable (RLS gates everything).
# Service role key NEVER goes here — it lives in moovli-api/.env only.
NEXT_PUBLIC_SUPABASE_URL=https://xaujutbtmpdnuqxgpokf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Public booking page base URL. Used by /studio/channels/direct to show the
# copy-paste URL and by booking-view share buttons. The Next.js middleware
# rewrites booking.<host>/<path> → /booking/<path>, so this single Node
# process serves both app.moovli.app and booking.moovli.app.
NEXT_PUBLIC_BOOKING_BASE_URL=https://booking.moovli.app

# Optional — leave unset unless used.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# NEXT_PUBLIC_SENTRY_DSN=
